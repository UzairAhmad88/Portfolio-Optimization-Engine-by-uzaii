# ==============================================================================
# Quantitative Portfolio Optimization Engine — Environment Configuration
# Copy this file to .env before starting the Docker Compose stack or local services.
# NEVER commit real credentials or production secrets to version control.
# ==============================================================================

# Application Environment ('development' or 'production')
APP_ENV=development

# Logging Level ('DEBUG', 'INFO', 'WARNING', 'ERROR')
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=quant_user
POSTGRES_PASSWORD=quant_password_change_in_production
POSTGRES_DB=quant_portfolio_db

# Primary Database Connection URL
# For Docker Compose, uses the internal service name 'postgres':
DATABASE_URL=postgresql+psycopg://quant_user:quant_password_change_in_production@postgres:5432/quant_portfolio_db

# For standalone host development with SQLite fallback:
# DATABASE_URL=sqlite:///./quant_portfolio.db

# Database Connection Pool Settings (PostgreSQL only)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30.0

# Database Migrations on Startup ('true' or 'false')
RUN_MIGRATIONS=true

# ------------------------------------------------------------------------------
# Authentication & Cryptographic Security
# ------------------------------------------------------------------------------
# Mandatory in production (APP_ENV=production): Must be at least 32 characters (256-bit entropy).
# The application fails closed at startup if left blank or using a known placeholder string.
# Generate a secure random key using:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# JWT Access Token Lifetime in Minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Allowed CORS Origins (Comma-separated, no wildcard '*' with credentials)
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173,http://127.0.0.1,http://127.0.0.1:80

# ------------------------------------------------------------------------------
# Server-Side PDF Rendering (Chromium)
# ------------------------------------------------------------------------------
# Explicit path to the Chromium / Chrome executable.
# Inside the container, this is installed at /usr/bin/chromium.
# On Windows workstations, typically: C:\Program Files\Google\Chrome\Application\chrome.exe
CHROME_BIN=/usr/bin/chromium

# Maximum concurrent Chromium rendering subprocesses
PDF_MAX_CONCURRENT_RENDERS=2

# ------------------------------------------------------------------------------
# Web Server & Ports
# ------------------------------------------------------------------------------
# Host port on which the frontend application is exposed
FRONTEND_PORT=80
