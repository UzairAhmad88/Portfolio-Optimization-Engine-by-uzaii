# Quant Portfolio Optimization Engine - Environment Configuration

# Database Configuration
# Default local SQLite file fallback for testing/offline development:
# DATABASE_URL=sqlite:///./quant_portfolio.db

# Production / Local Docker PostgreSQL Connection (psycopg v3):
DATABASE_URL=postgresql+psycopg://quant_user:quant_password@localhost:5432/quant_portfolio_db

# Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Authentication & Session Security (Session 11)
# Generate a cryptographically random secret in production: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_this_to_a_cryptographically_secure_random_key_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=60
COOKIE_SECURE=false # Set to true in production over HTTPS
AUTH_REQUIRED=true

# API Server & CORS Settings (Wildcard origins are strictly prohibited with credentialed cookies)
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Application Logging & Limits
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_BYTES=10485760
MAX_ROW_COUNT=100000
